ARG DOCKER_HUB="docker.io"

FROM ${DOCKER_HUB}/alpine:3.24

ENV UID=1337 \
    GID=1337

# 独立 Inbox 镜像只保留运行时证书。
RUN apk add --no-cache ca-certificates

ARG EXECUTABLE=./mautrix-whatsapp
COPY $EXECUTABLE /usr/bin/mautrix-whatsapp
VOLUME /data
WORKDIR /data

CMD ["/usr/bin/mautrix-whatsapp", "-config", "/data/config.yaml"]
